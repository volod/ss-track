{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ss-track:contract:result:command:1.10.0",
  "title": "Command",
  "type": "object",
  "description": "The shipped command format.",
  "properties": {
    "status": {
      "type": "string",
      "description": "Command outcome.",
      "enum": [
        "imported",
        "unchanged",
        "amended",
        "built",
        "staged",
        "verified",
        "recorded",
        "identical",
        "different",
        "listed",
        "valid",
        "refused",
        "diffed",
        "frozen",
        "written",
        "exported",
        "redecoded"
      ]
    },
    "code": {
      "type": "string",
      "description": "Stable refusal reason.",
      "enum": [
        "MANIFEST_INVALID",
        "SOURCE_NOT_FOUND",
        "SOURCE_UNREADABLE",
        "SOURCE_EMPTY",
        "SOURCE_HASH_MISMATCH",
        "SOURCE_DAMAGED",
        "SOURCE_NO_FRAMES",
        "SOURCE_FORMAT_CHANGED",
        "PTS_NON_INCREASING",
        "TIMESTAMP_CLAIM_UNSUPPORTED",
        "SELECTION_OUT_OF_RANGE",
        "SOURCE_NOT_IMPORTED",
        "SOURCE_RECORD_CHANGED",
        "RECORD_TAMPERED",
        "DECODE_POLICY_MISMATCH",
        "IMPORT_CONFLICT",
        "CORPUS_CONFLICT",
        "CORPUS_NOT_BUILT",
        "SPLIT_LEAKAGE",
        "STREAM_OVERLAP",
        "RETENTION_EXPIRED",
        "RIGHTS_CONFLICT",
        "CASE_INVALID",
        "TRANSFORM_REVISION_MISMATCH",
        "RECORD_SCHEMA_UNSUPPORTED",
        "DECODE_DRIFT",
        "BUNDLE_CONFLICT",
        "BUNDLE_NOT_STAGED",
        "FRAME_SET_NOT_STAGED",
        "FRAME_SET_MISMATCH",
        "HASHES_NOT_COMPARABLE",
        "STAGED_HASHES_DIFFER",
        "STAGING_IN_PROGRESS",
        "FRAME_CORRUPTED",
        "FRAME_NOT_IN_BUNDLE",
        "RECORD_INVALID",
        "CONTRACT_UNKNOWN",
        "CONTRACT_SET_INVALID",
        "STORAGE_FAILED",
        "VIDEO_STREAM_UNSPECIFIED",
        "COLOR_TAG_CONFLICT"
      ]
    },
    "message": {
      "type": "string",
      "description": "Explanation of a refusal."
    },
    "details": {
      "type": "object",
      "description": "Command-specific JSON refusal context, deliberately open.",
      "properties": {},
      "additionalProperties": true
    },
    "source_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Source identity. The file hash when the recording names its first video stream."
    },
    "manifest_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Manifest seal."
    },
    "manifest_path": {
      "type": "string",
      "description": "Local manifest path."
    },
    "timestamp_quality": {
      "type": "string",
      "description": "Timestamp evidence quality.",
      "enum": [
        "measured",
        "derived",
        "missing"
      ]
    },
    "frame_count": {
      "type": "integer",
      "description": "Decoded frame count.",
      "x-unit": "1",
      "minimum": 1
    },
    "completeness_checks": {
      "type": "array",
      "description": "Container completeness checks.",
      "items": {
        "type": "string",
        "description": "Check name."
      },
      "minItems": 0
    },
    "replaced_manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Previous source seal, or null when unchanged.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replaced_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path of the replaced source record, or null."
    },
    "changed_terms": {
      "type": "array",
      "description": "Amended term paths.",
      "items": {
        "type": "string",
        "description": "Field path."
      },
      "minItems": 0
    },
    "decode_policy_current": {
      "type": "boolean",
      "description": "Whether decoded facts use the installed policy."
    },
    "corpus_id": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
      "description": "Corpus version."
    },
    "stream_count": {
      "type": "integer",
      "description": "Number of streams.",
      "x-unit": "1",
      "minimum": 1
    },
    "generated_case_count": {
      "type": "integer",
      "description": "Number of generated cases.",
      "x-unit": "1",
      "minimum": 0
    },
    "splits": {
      "type": "object",
      "description": "Counts by evaluation split.",
      "properties": {
        "development": {
          "type": "object",
          "description": "Counts in one split.",
          "properties": {
            "group_count": {
              "type": "integer",
              "description": "Independent groups.",
              "x-unit": "1",
              "minimum": 0
            },
            "encounter_count": {
              "type": "integer",
              "description": "Encounters.",
              "x-unit": "1",
              "minimum": 0
            },
            "stream_count": {
              "type": "integer",
              "description": "Streams.",
              "x-unit": "1",
              "minimum": 0
            },
            "generated_case_count": {
              "type": "integer",
              "description": "Generated cases.",
              "x-unit": "1",
              "minimum": 0
            }
          },
          "required": [
            "group_count",
            "encounter_count",
            "stream_count",
            "generated_case_count"
          ],
          "additionalProperties": false
        },
        "calibration": {
          "type": "object",
          "description": "Counts in one split.",
          "properties": {
            "group_count": {
              "type": "integer",
              "description": "Independent groups.",
              "x-unit": "1",
              "minimum": 0
            },
            "encounter_count": {
              "type": "integer",
              "description": "Encounters.",
              "x-unit": "1",
              "minimum": 0
            },
            "stream_count": {
              "type": "integer",
              "description": "Streams.",
              "x-unit": "1",
              "minimum": 0
            },
            "generated_case_count": {
              "type": "integer",
              "description": "Generated cases.",
              "x-unit": "1",
              "minimum": 0
            }
          },
          "required": [
            "group_count",
            "encounter_count",
            "stream_count",
            "generated_case_count"
          ],
          "additionalProperties": false
        },
        "locked": {
          "type": "object",
          "description": "Counts in one split.",
          "properties": {
            "group_count": {
              "type": "integer",
              "description": "Independent groups.",
              "x-unit": "1",
              "minimum": 0
            },
            "encounter_count": {
              "type": "integer",
              "description": "Encounters.",
              "x-unit": "1",
              "minimum": 0
            },
            "stream_count": {
              "type": "integer",
              "description": "Streams.",
              "x-unit": "1",
              "minimum": 0
            },
            "generated_case_count": {
              "type": "integer",
              "description": "Generated cases.",
              "x-unit": "1",
              "minimum": 0
            }
          },
          "required": [
            "group_count",
            "encounter_count",
            "stream_count",
            "generated_case_count"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "lineage": {
      "description": "Whether and how the version is linked.",
      "oneOf": [
        {
          "type": "object",
          "description": "No declared predecessor.",
          "properties": {
            "status": {
              "type": "string",
              "description": "Lineage status.",
              "const": "no_lineage"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Comparison with the predecessor chain.",
          "properties": {
            "status": {
              "type": "string",
              "description": "Lineage status.",
              "const": "linked"
            },
            "supersedes": {
              "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
              "description": "Immediate predecessor."
            },
            "supersedes_manifest_sha256": {
              "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
              "description": "Immediate predecessor seal."
            },
            "compared_versions": {
              "type": "array",
              "description": "Compared corpus versions.",
              "items": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                "description": "Corpus version."
              },
              "minItems": 0
            },
            "added": {
              "type": "array",
              "description": "Sources added.",
              "items": {
                "type": "object",
                "description": "One source placement.",
                "properties": {
                  "source_sha256": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                    "description": "Source identity. The file hash when the recording names its first video stream."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "source_sha256",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "removed": {
              "type": "array",
              "description": "Sources removed.",
              "items": {
                "type": "object",
                "description": "One source placement.",
                "properties": {
                  "source_sha256": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                    "description": "Source identity. The file hash when the recording names its first video stream."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "source_sha256",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "kept": {
              "type": "array",
              "description": "Sources kept.",
              "items": {
                "type": "object",
                "description": "One source placement.",
                "properties": {
                  "source_sha256": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                    "description": "Source identity. The file hash when the recording names its first video stream."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "source_sha256",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "not_compared": {
              "type": "array",
              "description": "Predecessors whose major keeps no comparison projection, present only when one exists.",
              "items": {
                "type": "object",
                "description": "One missing comparison.",
                "properties": {
                  "corpus_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Corpus version."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why it could not be compared.",
                    "enum": [
                      "manifest_removed",
                      "no_frame_set",
                      "bundles_removed",
                      "other_decode_policy",
                      "other_schema"
                    ]
                  },
                  "stream_ids": {
                    "type": "array",
                    "description": "Affected streams.",
                    "items": {
                      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                      "description": "Stream."
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "corpus_id",
                  "reason",
                  "stream_ids"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "status",
            "supersedes",
            "supersedes_manifest_sha256",
            "compared_versions",
            "added",
            "removed",
            "kept"
          ],
          "additionalProperties": false
        }
      ]
    },
    "unlinked": {
      "type": "object",
      "description": "Other corpus versions on this data root that place a source of this version in another group or split. Absent when there is nothing to report. The build still succeeds.",
      "properties": {
        "placements": {
          "type": "array",
          "description": "Sources placed elsewhere, ordered by source hash, then by the other version's name.",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One source held by this version and by another version.",
            "properties": {
              "source_sha256": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                "description": "Source identity. The file hash when the recording names its first video stream."
              },
              "from": {
                "type": "object",
                "description": "Where another version on this data root places the source.",
                "properties": {
                  "corpus_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "The other corpus version."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "corpus_id",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "description": "Where this version places the source.",
                "properties": {
                  "corpus_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "This corpus version."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "corpus_id",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "source_sha256",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "scan": {
          "type": "string",
          "description": "Present when the corpus directory could not be listed, so no version was compared. Absent when the scan visited each version directory. The build still succeeds.",
          "enum": [
            "unreadable"
          ]
        },
        "not_compared": {
          "type": "array",
          "description": "Manifests on this data root that could not be read, or whose major keeps no projection. Present only when one exists, ordered by corpus version name.",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One manifest the listing could not compare.",
            "properties": {
              "corpus_id": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                "description": "Corpus directory name."
              },
              "reason": {
                "type": "string",
                "description": "Why the manifest was not compared.",
                "enum": [
                  "other_schema",
                  "unreadable"
                ]
              }
            },
            "required": [
              "corpus_id",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "description": "Corpus versions on this data root that pin the source record this command replaced, each with its frames directory. Absent when nothing needs reporting, including a repeat that replaced nothing. The replacement is still recorded.",
      "properties": {
        "versions": {
          "type": "array",
          "description": "Versions that pin the replaced record, ordered by corpus version name. A version is listed once however many of its streams pin it.",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One corpus version that pins the replaced source record.",
            "properties": {
              "corpus_id": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                "description": "Corpus version."
              },
              "frames_directory": {
                "type": "string",
                "description": "Directory that holds this version's staged frames, whether or not it currently contains files."
              }
            },
            "required": [
              "corpus_id",
              "frames_directory"
            ],
            "additionalProperties": false
          }
        },
        "not_compared": {
          "type": "array",
          "description": "Manifests on this data root that could not be read, or whose major keeps no projection. Present only when one exists, ordered by corpus version name. Such a version is not treated as absent.",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One manifest the listing could not compare.",
            "properties": {
              "corpus_id": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                "description": "Corpus directory name."
              },
              "reason": {
                "type": "string",
                "description": "Why the manifest was not compared.",
                "enum": [
                  "other_schema",
                  "unreadable"
                ]
              }
            },
            "required": [
              "corpus_id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "scan": {
          "type": "string",
          "description": "Present when the corpus directory could not be listed. Absent when the scan visited each version directory. The replacement is still recorded.",
          "enum": [
            "unreadable"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "frame_set_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Frame-set seal."
    },
    "bundles": {
      "type": "array",
      "description": "Staged bundle summaries.",
      "items": {
        "type": "object",
        "description": "One staged or verified bundle.",
        "properties": {
          "stream_id": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
            "description": "Stream or case id."
          },
          "status": {
            "type": "string",
            "description": "Bundle status.",
            "enum": [
              "staged",
              "unchanged",
              "verified"
            ]
          },
          "transform": {
            "type": "string",
            "description": "Transform name, or identity for an original stream."
          },
          "bundle_sha256": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
            "description": "Bundle identity hash."
          },
          "frame_count": {
            "type": "integer",
            "description": "Bundle frame count.",
            "x-unit": "1",
            "minimum": 1
          },
          "pixel_format": {
            "type": "string",
            "description": "Raw frame layout.",
            "const": "rgb24"
          },
          "width": {
            "type": "integer",
            "description": "Width.",
            "x-unit": "{pixel}",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "description": "Height.",
            "x-unit": "{pixel}",
            "minimum": 1
          },
          "manifest_path": {
            "type": "string",
            "description": "Local bundle manifest path."
          }
        },
        "required": [
          "stream_id",
          "status",
          "transform",
          "bundle_sha256",
          "frame_count",
          "pixel_format",
          "width",
          "height",
          "manifest_path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "shared_frames": {
      "type": "object",
      "description": "Coverage of the shared-frame check.",
      "properties": {
        "min_shared_frames": {
          "type": "integer",
          "description": "Minimum shared consecutive frames.",
          "x-unit": "1",
          "minimum": 1
        },
        "compared_versions": {
          "type": "array",
          "description": "Compared versions.",
          "items": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
            "description": "Corpus version."
          },
          "minItems": 0
        },
        "not_compared": {
          "type": "array",
          "description": "Uncompared predecessors.",
          "items": {
            "type": "object",
            "description": "One missing comparison.",
            "properties": {
              "corpus_id": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                "description": "Corpus version."
              },
              "reason": {
                "type": "string",
                "description": "Why it could not be compared.",
                "enum": [
                  "manifest_removed",
                  "no_frame_set",
                  "bundles_removed",
                  "other_decode_policy",
                  "other_schema"
                ]
              },
              "stream_ids": {
                "type": "array",
                "description": "Affected streams.",
                "items": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                  "description": "Stream."
                },
                "minItems": 0
              }
            },
            "required": [
              "corpus_id",
              "reason",
              "stream_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "min_shared_frames",
        "compared_versions",
        "not_compared"
      ],
      "additionalProperties": false
    },
    "bundle_count": {
      "type": "integer",
      "description": "Number of bundles.",
      "x-unit": "1",
      "minimum": 1
    },
    "host": {
      "type": "object",
      "description": "Host facts, outside the frame-set identity.",
      "properties": {
        "machine": {
          "type": "string",
          "description": "Processor architecture."
        },
        "system": {
          "type": "string",
          "description": "Operating system."
        },
        "python": {
          "type": "string",
          "description": "Python interpreter version."
        }
      },
      "required": [
        "machine",
        "system",
        "python"
      ],
      "additionalProperties": false
    },
    "record_path": {
      "type": "string",
      "description": "Local output record path."
    },
    "kind": {
      "type": "string",
      "description": "Comparison record kind, when embedded in a result.",
      "const": "ss-track.hash-comparison"
    },
    "schema_version": {
      "type": "integer",
      "description": "Embedded comparison record major.",
      "x-unit": "1",
      "const": 1,
      "minimum": 0
    },
    "source_count": {
      "type": "integer",
      "description": "Compared source count.",
      "x-unit": "1",
      "minimum": 1
    },
    "left": {
      "type": "object",
      "description": "One comparison side.",
      "properties": {
        "host": {
          "type": "object",
          "description": "Host facts, outside the frame-set identity.",
          "properties": {
            "machine": {
              "type": "string",
              "description": "Processor architecture."
            },
            "system": {
              "type": "string",
              "description": "Operating system."
            },
            "python": {
              "type": "string",
              "description": "Python interpreter version."
            }
          },
          "required": [
            "machine",
            "system",
            "python"
          ],
          "additionalProperties": false
        },
