{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ss-track:contract:result:command:1.1.0",
  "title": "Command",
  "type": "object",
  "description": "The shipped command format.",
  "properties": {
    "status": {
      "type": "string",
      "description": "Command outcome.",
      "enum": [
        "imported",
        "unchanged",
        "amended",
        "built",
        "staged",
        "verified",
        "recorded",
        "identical",
        "different",
        "listed",
        "valid",
        "refused",
        "diffed",
        "frozen"
      ]
    },
    "code": {
      "type": "string",
      "description": "Stable refusal reason.",
      "enum": [
        "MANIFEST_INVALID",
        "SOURCE_NOT_FOUND",
        "SOURCE_UNREADABLE",
        "SOURCE_EMPTY",
        "SOURCE_HASH_MISMATCH",
        "SOURCE_DAMAGED",
        "SOURCE_NO_FRAMES",
        "SOURCE_FORMAT_CHANGED",
        "PTS_NON_INCREASING",
        "TIMESTAMP_CLAIM_UNSUPPORTED",
        "SELECTION_OUT_OF_RANGE",
        "SOURCE_NOT_IMPORTED",
        "SOURCE_RECORD_CHANGED",
        "RECORD_TAMPERED",
        "DECODE_POLICY_MISMATCH",
        "IMPORT_CONFLICT",
        "CORPUS_CONFLICT",
        "CORPUS_NOT_BUILT",
        "SPLIT_LEAKAGE",
        "STREAM_OVERLAP",
        "RETENTION_EXPIRED",
        "RIGHTS_CONFLICT",
        "CASE_INVALID",
        "TRANSFORM_REVISION_MISMATCH",
        "RECORD_SCHEMA_UNSUPPORTED",
        "DECODE_DRIFT",
        "BUNDLE_CONFLICT",
        "BUNDLE_NOT_STAGED",
        "FRAME_SET_NOT_STAGED",
        "FRAME_SET_MISMATCH",
        "HASHES_NOT_COMPARABLE",
        "STAGED_HASHES_DIFFER",
        "STAGING_IN_PROGRESS",
        "FRAME_CORRUPTED",
        "FRAME_NOT_IN_BUNDLE",
        "RECORD_INVALID",
        "CONTRACT_UNKNOWN",
        "CONTRACT_SET_INVALID",
        "STORAGE_FAILED"
      ]
    },
    "message": {
      "type": "string",
      "description": "Explanation of a refusal."
    },
    "details": {
      "type": "object",
      "description": "Command-specific JSON refusal context, deliberately open.",
      "properties": {},
      "additionalProperties": true
    },
    "source_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Imported source bytes."
    },
    "manifest_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Manifest seal."
    },
    "manifest_path": {
      "type": "string",
      "description": "Local manifest path."
    },
    "timestamp_quality": {
      "type": "string",
      "description": "Timestamp evidence quality.",
      "enum": [
        "measured",
        "derived",
        "missing"
      ]
    },
    "frame_count": {
      "type": "integer",
      "description": "Decoded frame count.",
      "x-unit": "1",
      "minimum": 1
    },
    "completeness_checks": {
      "type": "array",
      "description": "Container completeness checks.",
      "items": {
        "type": "string",
        "description": "Check name."
      },
      "minItems": 0
    },
    "replaced_manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Previous source seal, or null when unchanged.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replaced_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path of the replaced source record, or null."
    },
    "changed_terms": {
      "type": "array",
      "description": "Amended term paths.",
      "items": {
        "type": "string",
        "description": "Field path."
      },
      "minItems": 0
    },
    "decode_policy_current": {
      "type": "boolean",
      "description": "Whether decoded facts use the installed policy."
    },
    "corpus_id": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
      "description": "Corpus version."
    },
    "stream_count": {
      "type": "integer",
      "description": "Number of streams.",
      "x-unit": "1",
      "minimum": 1
    },
    "generated_case_count": {
      "type": "integer",
      "description": "Number of generated cases.",
      "x-unit": "1",
      "minimum": 0
    },
    "splits": {
      "type": "object",
      "description": "Counts by evaluation split.",
      "properties": {
        "development": {
          "type": "object",
          "description": "Counts in one split.",
          "properties": {
            "group_count": {
              "type": "integer",
              "description": "Independent groups.",
              "x-unit": "1",
              "minimum": 0
            },
            "encounter_count": {
              "type": "integer",
              "description": "Encounters.",
              "x-unit": "1",
              "minimum": 0
            },
            "stream_count": {
              "type": "integer",
              "description": "Streams.",
              "x-unit": "1",
              "minimum": 0
            },
            "generated_case_count": {
              "type": "integer",
              "description": "Generated cases.",
              "x-unit": "1",
              "minimum": 0
            }
          },
          "required": [
            "group_count",
            "encounter_count",
            "stream_count",
            "generated_case_count"
          ],
          "additionalProperties": false
        },
        "calibration": {
          "type": "object",
          "description": "Counts in one split.",
          "properties": {
            "group_count": {
              "type": "integer",
              "description": "Independent groups.",
              "x-unit": "1",
              "minimum": 0
            },
            "encounter_count": {
              "type": "integer",
              "description": "Encounters.",
              "x-unit": "1",
              "minimum": 0
            },
            "stream_count": {
              "type": "integer",
              "description": "Streams.",
              "x-unit": "1",
              "minimum": 0
            },
            "generated_case_count": {
              "type": "integer",
              "description": "Generated cases.",
              "x-unit": "1",
              "minimum": 0
            }
          },
          "required": [
            "group_count",
            "encounter_count",
            "stream_count",
            "generated_case_count"
          ],
          "additionalProperties": false
        },
        "locked": {
          "type": "object",
          "description": "Counts in one split.",
          "properties": {
            "group_count": {
              "type": "integer",
              "description": "Independent groups.",
              "x-unit": "1",
              "minimum": 0
            },
            "encounter_count": {
              "type": "integer",
              "description": "Encounters.",
              "x-unit": "1",
              "minimum": 0
            },
            "stream_count": {
              "type": "integer",
              "description": "Streams.",
              "x-unit": "1",
              "minimum": 0
            },
            "generated_case_count": {
              "type": "integer",
              "description": "Generated cases.",
              "x-unit": "1",
              "minimum": 0
            }
          },
          "required": [
            "group_count",
            "encounter_count",
            "stream_count",
            "generated_case_count"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "lineage": {
      "description": "Whether and how the version is linked.",
      "oneOf": [
        {
          "type": "object",
          "description": "No declared predecessor.",
          "properties": {
            "status": {
              "type": "string",
              "description": "Lineage status.",
              "const": "no_lineage"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Comparison with the predecessor chain.",
          "properties": {
            "status": {
              "type": "string",
              "description": "Lineage status.",
              "const": "linked"
            },
            "supersedes": {
              "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
              "description": "Immediate predecessor."
            },
            "supersedes_manifest_sha256": {
              "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
              "description": "Immediate predecessor seal."
            },
            "compared_versions": {
              "type": "array",
              "description": "Compared corpus versions.",
              "items": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                "description": "Corpus version."
              },
              "minItems": 1
            },
            "added": {
              "type": "array",
              "description": "Sources added.",
              "items": {
                "type": "object",
                "description": "One source placement.",
                "properties": {
                  "source_sha256": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                    "description": "Source bytes."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "source_sha256",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "removed": {
              "type": "array",
              "description": "Sources removed.",
              "items": {
                "type": "object",
                "description": "One source placement.",
                "properties": {
                  "source_sha256": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                    "description": "Source bytes."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "source_sha256",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "kept": {
              "type": "array",
              "description": "Sources kept.",
              "items": {
                "type": "object",
                "description": "One source placement.",
                "properties": {
                  "source_sha256": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                    "description": "Source bytes."
                  },
                  "group_id": {
                    "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                    "description": "Group."
                  },
                  "split": {
                    "type": "string",
                    "description": "Evaluation partition.",
                    "enum": [
                      "development",
                      "calibration",
                      "locked"
                    ]
                  }
                },
                "required": [
                  "source_sha256",
                  "group_id",
                  "split"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "status",
            "supersedes",
            "supersedes_manifest_sha256",
            "compared_versions",
            "added",
            "removed",
            "kept"
          ],
          "additionalProperties": false
        }
      ]
    },
    "frame_set_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Frame-set seal."
    },
    "bundles": {
      "type": "array",
      "description": "Staged bundle summaries.",
      "items": {
        "type": "object",
        "description": "One staged or verified bundle.",
        "properties": {
          "stream_id": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
            "description": "Stream or case id."
          },
          "status": {
            "type": "string",
            "description": "Bundle status.",
            "enum": [
              "staged",
              "unchanged",
              "verified"
            ]
          },
          "transform": {
            "type": "string",
            "description": "Transform name, or identity for an original stream."
          },
          "bundle_sha256": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
            "description": "Bundle identity hash."
          },
          "frame_count": {
            "type": "integer",
            "description": "Bundle frame count.",
            "x-unit": "1",
            "minimum": 1
          },
          "pixel_format": {
            "type": "string",
            "description": "Raw frame layout.",
            "const": "rgb24"
          },
          "width": {
            "type": "integer",
            "description": "Width.",
            "x-unit": "{pixel}",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "description": "Height.",
            "x-unit": "{pixel}",
            "minimum": 1
          },
          "manifest_path": {
            "type": "string",
            "description": "Local bundle manifest path."
          }
        },
        "required": [
          "stream_id",
          "status",
          "transform",
          "bundle_sha256",
          "frame_count",
          "pixel_format",
          "width",
          "height",
          "manifest_path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "shared_frames": {
      "type": "object",
      "description": "Coverage of the shared-frame check.",
      "properties": {
        "min_shared_frames": {
          "type": "integer",
          "description": "Minimum shared consecutive frames.",
          "x-unit": "1",
          "minimum": 1
        },
        "compared_versions": {
          "type": "array",
          "description": "Compared versions.",
          "items": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
            "description": "Corpus version."
          },
          "minItems": 0
        },
        "not_compared": {
          "type": "array",
          "description": "Uncompared predecessors.",
          "items": {
            "type": "object",
            "description": "One missing comparison.",
            "properties": {
              "corpus_id": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                "description": "Corpus version."
              },
              "reason": {
                "type": "string",
                "description": "Why it could not be compared.",
                "enum": [
                  "manifest_removed",
                  "no_frame_set",
                  "bundles_removed",
                  "other_decode_policy",
                  "other_schema"
                ]
              },
              "stream_ids": {
                "type": "array",
                "description": "Affected streams.",
                "items": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                  "description": "Stream."
                },
                "minItems": 0
              }
            },
            "required": [
              "corpus_id",
              "reason",
              "stream_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "min_shared_frames",
        "compared_versions",
        "not_compared"
      ],
      "additionalProperties": false
    },
    "bundle_count": {
      "type": "integer",
      "description": "Number of bundles.",
      "x-unit": "1",
      "minimum": 1
    },
    "host": {
      "type": "object",
      "description": "Host facts, outside the frame-set identity.",
      "properties": {
        "machine": {
          "type": "string",
          "description": "Processor architecture."
        },
        "system": {
          "type": "string",
          "description": "Operating system."
        },
        "python": {
          "type": "string",
          "description": "Python interpreter version."
        }
      },
      "required": [
        "machine",
        "system",
        "python"
      ],
      "additionalProperties": false
    },
    "record_path": {
      "type": "string",
      "description": "Local output record path."
    },
    "kind": {
      "type": "string",
      "description": "Comparison record kind, when embedded in a result.",
      "const": "ss-track.hash-comparison"
    },
    "schema_version": {
      "type": "integer",
      "description": "Embedded comparison record major.",
      "x-unit": "1",
      "const": 1,
      "minimum": 0
    },
    "source_count": {
      "type": "integer",
      "description": "Compared source count.",
      "x-unit": "1",
      "minimum": 1
    },
    "left": {
      "type": "object",
      "description": "One comparison side.",
      "properties": {
        "host": {
          "type": "object",
          "description": "Host facts, outside the frame-set identity.",
          "properties": {
            "machine": {
              "type": "string",
              "description": "Processor architecture."
            },
            "system": {
              "type": "string",
              "description": "Operating system."
            },
            "python": {
              "type": "string",
              "description": "Python interpreter version."
            }
          },
          "required": [
            "machine",
            "system",
            "python"
          ],
          "additionalProperties": false
        },
        "frame_set_sha256": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
          "description": "Frame-set seal."
        },
        "corpus_manifest_sha256": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
          "description": "Corpus seal."
        }
      },
      "required": [
        "host",
        "frame_set_sha256",
        "corpus_manifest_sha256"
      ],
      "additionalProperties": false
    },
    "right": {
      "type": "object",
      "description": "One comparison side.",
      "properties": {
        "host": {
          "type": "object",
          "description": "Host facts, outside the frame-set identity.",
          "properties": {
            "machine": {
              "type": "string",
              "description": "Processor architecture."
            },
            "system": {
              "type": "string",
              "description": "Operating system."
            },
            "python": {
              "type": "string",
              "description": "Python interpreter version."
            }
          },
          "required": [
            "machine",
            "system",
            "python"
          ],
          "additionalProperties": false
        },
        "frame_set_sha256": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
          "description": "Frame-set seal."
        },
        "corpus_manifest_sha256": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
          "description": "Corpus seal."
        }
      },
      "required": [
        "host",
        "frame_set_sha256",
        "corpus_manifest_sha256"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "description": "Differing source reports.",
      "items": {
        "type": "object",
        "description": "One differing source.",
        "properties": {
          "source_sha256": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
            "description": "Source bytes."
          },
          "codec": {
            "type": "string",
            "description": "Left codec name."
          },
          "source_pixel_format": {
            "type": "string",
            "description": "Left pixel format name."
          },
          "source_record_differs": {
            "type": "boolean",
            "description": "Whether imported source seals differ."
          },
          "bundles": {
            "type": "array",
            "description": "Differing bundles of this source.",
            "items": {
              "type": "object",
              "description": "One differing bundle.",
              "properties": {
                "stream_id": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                  "description": "Stream or case identifier."
                },
                "parent_stream_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Parent stream, or null for original stream.",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                },
                "left_bundle_sha256": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                  "description": "Left identity hash."
                },
                "right_bundle_sha256": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                  "description": "Right identity hash."
                },
                "frame_count": {
                  "type": "integer",
                  "description": "Number of frames on the left.",
                  "x-unit": "1",
                  "minimum": 0
                },
                "differing_frames": {
                  "type": "integer",
                  "description": "Number of indexes with missing or differing hash or PTS.",
                  "x-unit": "1",
                  "minimum": 0
                },
                "first_differing_frame": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Smallest differing source frame index, or null.",
                  "x-unit": "1",
                  "minimum": 0
                }
              },
              "required": [
                "stream_id",
                "parent_stream_id",
                "left_bundle_sha256",
                "right_bundle_sha256",
                "frame_count",
                "differing_frames",
                "first_differing_frame"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "source_sha256",
          "codec",
          "source_pixel_format",
          "source_record_differs",
          "bundles"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "root": {
      "type": "string",
      "description": "Installed contracts directory."
    },
    "contracts": {
      "type": "array",
      "description": "Contract listing.",
      "items": {
        "type": "object",
        "description": "One listed contract.",
        "properties": {
          "contract": {
            "type": "string",
            "description": "Family/id."
          },
          "family": {
            "type": "string",
            "description": "Contract family.",
            "enum": [
              "declaration",
              "record",
              "event",
              "result",
              "external",
              "shared"
            ]
          },
          "id": {
            "type": "string",
            "description": "Format id."
          },
          "owner": {
            "type": "string",
            "description": "Owning capability."
          },
          "status": {
            "type": "string",
            "description": "Contract lifecycle.",
            "enum": [
              "draft",
              "active",
              "deprecated",
              "retired"
            ]
          },
          "description": {
            "type": "string",
            "description": "Format summary."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason a draft has no frozen version."
          },
          "versions": {
            "type": "array",
            "description": "Frozen versions.",
            "items": {
              "type": "object",
              "description": "One frozen contract version.",
              "properties": {
                "version": {
                  "type": "string",
                  "description": "Semantic version."
                },
                "urn": {
                  "type": "string",
                  "description": "Frozen contract URN."
                },
                "file_sha256": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                  "description": "Exact file hash."
                },
                "structure": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                  "description": "Structural fingerprint."
                },
                "meaning": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                  "description": "Semantic fingerprint."
                },
                "change": {
                  "type": "object",
                  "description": "Frozen version change log.",
                  "properties": {
                    "class": {
                      "type": "string",
                      "description": "Compatibility class.",
                      "enum": [
                        "initial",
                        "patch",
                        "minor",
                        "major"
                      ]
                    },
                    "summary": {
                      "type": "string",
