{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ss-track:contract:declaration:corpus:3.1.0",
  "title": "Corpus",
  "type": "object",
  "description": "The shipped corpus format.",
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Declaration major.",
      "x-unit": "1",
      "const": 3,
      "minimum": 0
    },
    "corpus_id": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
      "description": "New corpus version identifier."
    },
    "decode_policy_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Optional installed decode-policy pin."
    },
    "supersedes": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
      "description": "Optional predecessor corpus version."
    },
    "scenario_rights": {
      "type": "object",
      "description": "Rights requested by the corpus scenario.",
      "properties": {
        "sharing": {
          "type": "string",
          "description": "Permitted disclosure scope.",
          "enum": [
            "restricted",
            "public"
          ]
        },
        "max_sensitivity": {
          "type": "string",
          "description": "Declared sensitivity.",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        }
      },
      "required": [
        "sharing",
        "max_sensitivity"
      ],
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "description": "Corpus groups.",
      "items": {
        "type": "object",
        "description": "Related encounters assigned together.",
        "properties": {
          "group_id": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
            "description": "Group identifier."
          },
          "split": {
            "type": "string",
            "description": "Evaluation partition.",
            "enum": [
              "development",
              "calibration",
              "locked"
            ]
          },
          "encounters": {
            "type": "array",
            "description": "Encounters in this group.",
            "items": {
              "type": "object",
              "description": "One encounter.",
              "properties": {
                "encounter_id": {
                  "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                  "description": "Encounter identifier."
                },
                "streams": {
                  "type": "array",
                  "description": "Sensor streams.",
                  "items": {
                    "type": "object",
                    "description": "One selected recording and its generated cases.",
                    "properties": {
                      "stream_id": {
                        "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
                        "description": "Stream identifier."
                      },
                      "source_sha256": {
                        "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                        "description": "Imported source bytes."
                      },
                      "selection": {
                        "$ref": "#/$defs/selection",
                        "description": "Optional selection; absent selects the entire source."
                      },
                      "generated_cases": {
                        "type": "array",
                        "description": "Generated cases inheriting stream membership.",
                        "items": {
                          "$ref": "#/$defs/recipe",
                          "description": "One generated-case recipe."
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "stream_id",
                      "source_sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "encounter_id",
                "streams"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "group_id",
          "split",
          "encounters"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "scenario_rights",
    "groups"
  ],
  "additionalProperties": false,
  "$defs": {
    "selection": {
      "type": "object",
      "description": "Half-open source frame window.",
      "properties": {
        "start_frame": {
          "type": "integer",
          "description": "Inclusive zero-based source frame index.",
          "x-unit": "1",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "description": "Exclusive zero-based source frame index.",
          "x-unit": "1",
          "minimum": 1
        }
      },
      "required": [
        "start_frame",
        "end_frame"
      ],
      "additionalProperties": false,
      "x-rules": {
        "order": "start_frame is strictly before end_frame and the window lies within its parent selection."
      }
    },
    "region": {
      "type": "object",
      "description": "Rectangle in decoded image coordinates.",
      "properties": {
        "x": {
          "type": "integer",
          "description": "Left edge from image left.",
          "x-unit": "{pixel}",
          "x-frame": "decoded image",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "description": "Top edge from image top.",
          "x-unit": "{pixel}",
          "x-frame": "decoded image",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "description": "Rectangle width.",
          "x-unit": "{pixel}",
          "x-frame": "decoded image",
          "minimum": 1
