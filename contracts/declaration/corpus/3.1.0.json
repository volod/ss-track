          "description": "Rectangle height.",
          "x-unit": "{pixel}",
          "x-frame": "decoded image",
          "minimum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
