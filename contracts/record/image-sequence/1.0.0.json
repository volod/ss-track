{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ss-track:contract:record:image-sequence:1.0.0",
  "title": "Image sequence inventory",
  "description": "Pinned ordered lossless image membership and declared timing.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "ss-track.image-sequence",
      "description": "Record kind."
    },
    "schema_version": {
      "type": "integer",
      "const": 1,
      "minimum": 0,
      "x-unit": "1",
      "description": "Format major."
    },
    "manifest_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Record seal."
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered image hashes.",
      "items": {
        "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256"
      },
      "x-sensitivity": "restricted"
    },
    "frame_rate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$",
      "description": "Declared frames per second; null means no timing.",
      "x-unit": "Hz",
      "x-sensitivity": "public"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "manifest_sha256",
    "hashes",
    "frame_rate"
  ],
  "additionalProperties": false
}
