{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ss-track:contract:record:frame-bundle:3.0.0",
  "title": "Frame bundle",
  "type": "object",
  "description": "The shipped frame-bundle format.",
  "properties": {
    "kind": {
      "type": "string",
      "description": "Names this record format.",
      "const": "ss-track.frame-bundle"
    },
    "schema_version": {
      "type": "integer",
      "description": "The format major, independent of algorithm revisions.",
      "x-unit": "1",
      "const": 3,
      "minimum": 0
    },
    "manifest_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Seal of this record, excluding this field."
    },
    "corpus_id": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
      "description": "Owning corpus version."
    },
    "corpus_manifest_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Owning corpus seal."
    },
    "stream_id": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
      "description": "Stream or generated-case identifier."
    },
    "source_manifest_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Imported source seal."
    },
    "bundle_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "SHA-256 of canonical identity JSON."
    },
    "identity": {
      "type": "object",
      "description": "Content identity independent of corpus and stream names.",
      "properties": {
        "source_sha256": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
          "description": "Source file bytes."
        },
        "decode_policy_sha256": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
          "description": "Pinned decode policy."
        },
        "selection": {
          "type": "object",
          "description": "Half-open source frame window.",
          "properties": {
            "start_frame": {
              "type": "integer",
              "description": "Inclusive zero-based source frame index.",
              "x-unit": "1",
              "minimum": 0
            },
            "end_frame": {
              "type": "integer",
              "description": "Exclusive zero-based source frame index.",
              "x-unit": "1",
              "minimum": 1
            }
          },
          "required": [
            "start_frame",
            "end_frame"
          ],
          "additionalProperties": false,
          "x-rules": {
            "order": "start_frame is strictly before end_frame and the window lies within its parent selection."
          }
        },
        "pixel_format": {
          "type": "string",
          "description": "Packed row-major RGB, eight bits per component.",
          "const": "rgb24"
        },
        "width": {
          "type": "integer",
          "description": "Frame width.",
          "x-unit": "{pixel}",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "description": "Frame height.",
          "x-unit": "{pixel}",
          "minimum": 1
        },
        "bytes_per_frame": {
          "type": "integer",
          "description": "Raw bytes per frame.",
          "x-unit": "By",
          "minimum": 1
        },
        "time_base": {
          "type": [
            "string",
            "null"
          ],
          "description": "Seconds per presentation timestamp tick, as a rational numerator/denominator.",
          "pattern": "^-?[0-9]+/[1-9][0-9]*$",
          "x-unit": "s",
          "x-clock": "source presentation timeline"
        },
        "frames": {
          "type": "array",
          "description": "Frame entries in ascending source frame order.",
          "items": {
            "type": "object",
            "description": "One stored frame.",
            "properties": {
              "frame_index": {
                "type": "integer",
                "description": "Zero-based original source frame index.",
                "x-unit": "1",
                "minimum": 0
              },
              "pts": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Presentation timestamp in stream time_base ticks; null means absent.",
                "x-unit": "{tick}",
                "x-clock": "source presentation timeline"
              },
              "sha256": {
                "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
                "description": "SHA-256 of the raw RGB frame."
              },
              "content_frame_index": {
                "type": "integer",
                "description": "Earlier source frame whose pixels are repeated.",
                "x-unit": "1",
                "minimum": 0
              }
            },
            "required": [
              "frame_index",
              "pts",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "parent_bundle_sha256": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
          "description": "Parent bundle identity, for a generated case."
        },
        "recipe": {
          "$ref": "#/$defs/recipe",
          "description": "Pinned generated recipe."
        },
        "label_transform": {
          "$ref": "#/$defs/labels",
          "description": "Generated label mapping."
        }
      },
      "required": [
        "source_sha256",
        "decode_policy_sha256",
        "selection",
        "pixel_format",
        "width",
        "height",
        "bytes_per_frame",
        "time_base",
        "frames"
      ],
      "additionalProperties": false
    },
    "source_pixel_format": {
      "type": "string",
      "description": "FFmpeg source pixel format name."
    },
    "source_bits_per_component": {
      "type": "integer",
      "description": "Source precision per color component.",
      "x-unit": "bit",
      "minimum": 1
    },
    "precision_reduced": {
      "type": "boolean",
      "description": "Whether conversion reduced source precision."
    },
    "color": {
      "type": "object",
      "description": "Unmodified FFmpeg color metadata; unspecified codes remain unspecified.",
      "properties": {
        "range": {
          "type": "integer",
          "description": "Full or limited signal range.",
          "x-unit": "1",
          "x-vocabulary": "FFmpeg AVColorRange"
        },
        "matrix": {
          "type": "integer",
          "description": "YUV to RGB coefficient matrix.",
          "x-unit": "1",
          "x-vocabulary": "FFmpeg AVColorSpace"
        },
        "primaries": {
          "type": "integer",
          "description": "Color primaries.",
          "x-unit": "1",
          "x-vocabulary": "FFmpeg AVColorPrimaries"
        },
        "transfer": {
          "type": "integer",
          "description": "Transfer characteristic.",
          "x-unit": "1",
          "x-vocabulary": "FFmpeg AVColorTransferCharacteristic"
        },
        "chroma_location": {
          "type": "integer",
          "description": "Chroma sample siting.",
          "x-unit": "1",
          "x-vocabulary": "FFmpeg AVChromaLocation"
        }
      },
      "required": [
        "range",
        "matrix",
        "primaries",
        "transfer",
        "chroma_location"
      ],
      "additionalProperties": false
    },
    "display_rotation_degrees": {
      "type": "integer",
      "description": "Source display rotation.",
      "x-unit": "deg"
    },
    "interlaced_frames": {
      "type": "integer",
      "description": "Number of interlaced source frames.",
      "x-unit": "1",
      "minimum": 0
    },
    "timestamp_quality": {
      "type": "string",
      "description": "Timestamp evidence quality.",
      "enum": [
        "measured",
        "derived",
        "missing"
      ]
    },
    "capture_clock_evidence": {
      "type": [
        "string",
        "null"
      ],
      "description": "Operator evidence for a measured capture clock."
    },
    "generated": {
      "type": [
        "object",
        "null"
      ],
      "description": "Inherited generated-case membership; null for an original stream.",
      "properties": {
        "parent_stream_id": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
          "description": "Parent stream."
        },
        "encounter_id": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
          "description": "Inherited encounter."
        },
        "group_id": {
          "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/identifier",
          "description": "Inherited group."
        },
        "split": {
          "type": "string",
          "description": "Evaluation partition.",
          "enum": [
            "development",
            "calibration",
            "locked"
          ]
        }
      },
      "required": [
        "parent_stream_id",
        "encounter_id",
        "group_id",
        "split"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schema_version",
    "manifest_sha256",
    "corpus_id",
    "corpus_manifest_sha256",
    "stream_id",
    "source_manifest_sha256",
    "bundle_sha256",
    "identity",
    "source_pixel_format",
    "source_bits_per_component",
    "precision_reduced",
    "color",
    "display_rotation_degrees",
    "interlaced_frames",
    "timestamp_quality",
    "capture_clock_evidence",
    "generated"
  ],
  "additionalProperties": false,
