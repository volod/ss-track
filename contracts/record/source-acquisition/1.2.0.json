{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ss-track:contract:record:source-acquisition:1.2.0",
  "title": "Source acquisition",
  "description": "Verified source acquisition and selection, linked to a source inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "manifest_sha256",
    "provider",
    "collection_id",
    "revision",
    "inventory_sha256",
    "archive_md5",
    "archive_sha256",
    "videos"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "ss-track.source-acquisition",
      "description": "Record kind."
    },
    "schema_version": {
      "type": "integer",
      "const": 1,
      "minimum": 0,
      "x-unit": "1",
      "description": "Record major."
    },
    "manifest_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "Seal over every other field."
    },
    "provider": {
      "type": "string",
      "enum": [
        "zenodo",
        "huggingface"
      ],
      "description": "Provider."
    },
    "collection_id": {
      "type": "string",
      "minLength": 1,
      "description": "Pinned provider collection identifier.",
      "x-rules": {
        "text": "A text value contains a character other than whitespace."
      }
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "description": "Pinned provider version or commit.",
      "x-rules": {
        "text": "A text value contains a character other than whitespace."
      }
    },
    "inventory_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "SHA-256 of the normalized inventory declaration."
    },
    "archive_md5": {
      "type": [
        "string",
        "null"
      ],
      "description": "Published archive MD5, when applicable."
    },
    "archive_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Local archive SHA-256, when applicable."
    },
    "videos": {
      "type": "array",
      "description": "Explicitly selected acquired videos.",
      "items": {
        "type": "object",
        "description": "One selected video.",
        "additionalProperties": false,
        "required": [
          "path",
          "local_path",
          "size",
          "sha256",
          "git_oid",
          "lfs_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Upstream path.",
            "x-rules": {
              "text": "A text value contains a character other than whitespace."
            }
          },
          "local_path": {
            "type": "string",
            "minLength": 1,
            "description": "Run-relative path of acquired video.",
            "x-rules": {
              "text": "A text value contains a character other than whitespace."
            }
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "x-unit": "byte",
            "description": "File size in bytes."
          },
          "sha256": {
            "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
            "description": "SHA-256 of local video bytes."
          },
          "git_oid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Upstream Git object identifier, when provided."
          },
          "lfs_sha256": {
            "type": [
              "string",
              "null"
            ],
            "description": "Upstream LFS SHA-256, when provided."
          }
        }
      }
    },
    "input_inventory_sha256": {
      "$ref": "urn:ss-track:contract:shared:types:1.0.0#/$defs/sha256",
      "description": "SHA-256 of the normalized operator inventory before provider enumeration."
    },
    "split_md5": {
      "type": [
        "string",
        "null"
      ],
      "description": "Published MD5 of the optional Zenodo split metadata."
    },
    "split_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Local SHA-256 of the optional Zenodo split metadata."
    }
  },
  "x-rules": {
    "selection": "Video paths are unique and local paths stay within the run.",
    "rights": "The inventory retains operator-provided rights evidence; the record does not grant rights."
  }
}
