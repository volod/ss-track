# Copy to .env for local overrides. Relative paths resolve from the project root.
DATA_DIR=.data

# Leave unset or use auto. The shared bootstrap selects copy only across filesystems.
# UV_LINK_MODE=auto

# Application logging level.
LOG_LEVEL=INFO

# Optional. Owner-managed folder for awareness material that is not part of the software project.
# Nothing in the repository reads it, so a clone works without it.
# ORG_ARTIFACTS_DIR=../ss-track-org
